# 仅作字段说明；不要把真实密钥写进仓库。Vercel 中逐项填写 Production 环境变量。
# DATABASE_URL 由 Neon/PostgreSQL 集成提供，连接需开启 SSL。
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
# 只填写你自己的项目域名，不带 https://；多个域名用英文逗号隔开。
DJANGO_ALLOWED_HOSTS=your-project.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app
# 可选：创建云端演示账号、商品和独立管理员。密码需先在密码管理器中随机生成。
CAMPUS_INIT_DEMO=1
CAMPUS_ADMIN_USERNAME=course_admin
CAMPUS_ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
